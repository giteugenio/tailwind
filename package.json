{
  "name": "cakephp-tailwind-app",
  "private": true,
  "scripts": {
    "css:build": "tailwindcss -i src/css/app.css -o webroot/css/app.css --minify",
    "css:watch": "tailwindcss -i src/css/app.css -o webroot/css/app.css --watch",
    "js:build": "node -e \"const fs=require('fs'); fs.copyFileSync('node_modules/alpinejs/dist/cdn.min.js', 'webroot/js/alpine.min.js'); fs.copyFileSync('node_modules/htmx.org/dist/htmx.min.js', 'webroot/js/htmx.min.js')\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "alpinejs": "^3.17.5",
    "htmx.org": "^2.0.11"
  }
}
